# --- Auth (REQUIRED) ---
# AUTH_REQUIRED defaults to TRUE. Leave it unset in production. Setting it to
# false disables authentication entirely — local development only.
AUTH_REQUIRED=false
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Must be >= 32 chars and not a known dev value, or the app refuses to boot.
SESSION_SECRET=
# Must be true in production (HTTPS); required when AUTH_REQUIRED is on.
COOKIE_SECURE=false
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3100

# CockroachDB connection string (CockroachDB Cloud -> Connect -> General connection string)
DATABASE_URL=postgresql://<user>:<password>@<host>:26257/defaultdb?sslmode=verify-full

# --- Model providers (plug and play) ---
# LLM_PROVIDER: openai | bedrock      (chat/agent model)
# EMBEDDING_PROVIDER: openai | bedrock (vector embeddings, 512 dims either way)
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# OpenAI mode (free-tier friendly dev mode)
OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Bedrock mode (hackathon-judged mode; requires Bedrock model access in this region)
# Credentials come from the AWS default chain — run `aws login --region us-east-1`
# locally (browser sign-in, short-lived creds); deployed environments use IAM roles.
# Static access keys are supported by the chain but not required.
AWS_REGION=us-east-1
# BEDROCK_CHAT_MODEL=anthropic.claude-sonnet-4-5-v1:0
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
